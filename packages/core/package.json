{
  "name": "@vegamo/deepcode-core",
  "version": "0.5.0",
  "description": "Deep Code core library — LLM session management, tool execution, and shared utilities",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lessweb/deepcode-cli.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings-diagnostics": {
      "types": "./dist/settings-diagnostics.d.ts",
      "import": "./dist/settings-diagnostics.js"
    },
    "./common/doctor-api": {
      "types": "./dist/common/doctor-api.d.ts",
      "import": "./dist/common/doctor-api.js"
    },
    "./common/plus-subscription": {
      "types": "./dist/common/plus-subscription.d.ts",
      "import": "./dist/common/plus-subscription.js"
    },
    "./common/shell-utils": {
      "types": "./dist/common/shell-utils.d.ts",
      "import": "./dist/common/shell-utils.js"
    },
    "./common/npm-registry": {
      "types": "./dist/common/npm-registry.d.ts",
      "import": "./dist/common/npm-registry.js"
    },
    "./common/plan-implementation": {
      "types": "./dist/common/plan-implementation.d.ts",
      "import": "./dist/common/plan-implementation.js"
    },
    "./common/slash-commands": {
      "types": "./dist/common/slash-commands.d.ts",
      "import": "./dist/common/slash-commands.js"
    },
    "./common/session-id": {
      "types": "./dist/common/session-id.d.ts",
      "import": "./dist/common/session-id.js"
    },
    "./common/process-tree": {
      "types": "./dist/common/process-tree.d.ts",
      "import": "./dist/common/process-tree.js"
    }
  },
  "files": [
    "dist/**",
    "templates/**"
  ],
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "build": "tsc -p ./",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "test": "node src/tests/run-tests.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "ejs": "^5.0.2",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5",
    "openai": "^6.35.0",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  }
}
